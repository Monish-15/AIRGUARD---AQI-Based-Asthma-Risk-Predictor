# ---------------------------------------------------------------------------
# AirGuard Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials or secrets to Git!
# ---------------------------------------------------------------------------

# Next.js Server & Security
AUTH_SECRET=change_me_to_a_secure_random_32_character_secret_key
DEMO_USER_EMAIL=demo@airguard.app
DEMO_USER_PASSWORD=change_me_to_a_strong_password

# Internal FastAPI Backend URL (Server-side Next.js route handlers)
BACKEND_API_URL=http://127.0.0.1:8000

# Optional Public API URL (Only required if frontend calls API directly across domains)
NEXT_PUBLIC_API_URL=
