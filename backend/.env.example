# ---------------------------------------------------------------------------
# AirGuard Proactive Alert System - Email / SMTP Configuration
# ---------------------------------------------------------------------------
# To receive REAL email notifications on High/Critical asthma alerts:
#
# Option A: Gmail (Recommended & Free)
# 1. Go to your Google Account: https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled.
# 3. Create an App Password at: https://myaccount.google.com/apppasswords
#    - Select app name: "AirGuard"
#    - Google will give you a 16-character password (e.g. "abcd efgh ijkl mnop")
# 4. Fill in below:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=youremail@gmail.com
#    SMTP_PASSWORD=your16charapppassword
#    SMTP_FROM=AirGuard Alerts <youremail@gmail.com>
#    SMTP_TLS=true
#
# Option B: Outlook / Hotmail
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USER=youremail@outlook.com
#    SMTP_PASSWORD=yourpassword
#
# Option C: Brevo / SendGrid / Mailgun
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_USER=your_smtp_login
#    SMTP_PASSWORD=your_smtp_key
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Authentication & Security Secrets
AUTH_SECRET=change_me_to_a_secure_random_32_character_secret_key
DEMO_USER_EMAIL=demo@airguard.app
DEMO_USER_PASSWORD=change_me_to_a_strong_password
